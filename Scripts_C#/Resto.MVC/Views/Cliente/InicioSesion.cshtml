@model Resto.MVC.Controllers.Modal.ClienteModal
@{
    ViewData["Title"] = "Alta Cliente";
}

<body>
    <div class="auth-background">
        <div class="auth-container">
            <div class="auth-card">
                <h2>Inicio de Sesión</h2>
                <form asp-action="InicioSesion" method="post" id="login-form">
                    <div class="form-group">
                        <label for="email">Correo electrónico</label>
                        <input type="email" id="email" asp-for="Email" required placeholder="Correo electrónico"
                            class="form-input" />
                        <div class="invalid-feedback">Por favor, ingrese un correo electrónico válido.</div>
                        <span id="error-message-username" class="text-error"></span>
                    </div>
                    <div class="form-group">
                        <label for="password">Contraseña</label>
                        <input type="password" id="password" asp-for="password" required placeholder="Contraseña"
                            class="form-input" />
                        <div class="invalid-feedback">Por favor, ingrese su contraseña.</div>
                        <span id="error-message-password" class="text-error"></span>
                    </div>
                    @if (Model.error)
                    {
                        <span>Verifique el email o contraseña</span>
                    }
                    <button type="submit" class="btn-submit">Iniciar Sesión</button>
                                    
                </form>
            </div>
        </div>
    </div>

    <style>
        body,
        html {
            height: 100%;
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #eceff1, #cfd8dc);
        }

        .auth-background {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 75vh;
        }

        .auth-container {
            background-color: #fff;
            border-radius: 8px;
            padding: 2rem;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            width: 100%;
            max-width: 400px;
            text-align: center;
        }

        .auth-card h2 {
            margin-bottom: 1.5rem;
            color: #333;
        }

        .form-group {
            margin-bottom: 1rem;
            text-align: left;
        }

        .form-group label {
            font-weight: bold;
            display: block;
            margin-bottom: 0.5rem;
        }

        .form-input {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 1rem;
            outline: none;
        }

        .form-input:focus {
            border-color: #42a5f5;
        }

        .btn-submit {
            width: 100%;
            padding: 0.75rem;
            background-color: #42a5f5;
            color: #fff;
            font-size: 1rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .btn-submit:hover {
            background-color: #1e88e5;
        }

        .text-error {
            color: #d32f2f;
            font-size: 0.875rem;
            margin-top: 0.5rem;
        }
    </style>
</body>