@model Biblioteca.Plato
<div class="container mt-3">
    @if (Model != null)
    {
        <div class="card">
            <div class="card-header">
                <h2>Información del PLato</h2>
            </div>
            <div class="card-body">
                <h5>Nombre del plato:</h5>
                <p>@Model.plato</p>

                <h5>Descripcion:</h5>
                <p>@Model.descripcion</p>

                <h5>Disponible:</h5>
                @if (Model.disponible)
                {
                    <p>si</p>
                }
                else
                {
                    <p>no</p>
                }
            </div>
        </div>
    }

<!DOCTYPE html>
<html>
<head>
    <title>Mi Proyecto</title>
</head>
<body>
    <img src="@Url.Content(Model.foto)" alt="Descripción de la imagen" />
</body>
</html>

    @if (Model != null)
    {
        <div class="card">
            <div class="card-header">
                <h2>Los creadores de esta exiquisites son</h2>
            </div>
            <div class="card-body">
                <h5> <a class="dropdown-item" asp-controller="Restaurante" asp-action="ObtenerDetalleResto"
                        asp-route-idRestaurant="@Model.idRestaurant">
                        <i class="bi bi-list-nested"></i>Nombre del Restaurante: @Model.Restaurant.restaurante
                    </a>
                </h5>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger" role="alert">
            plato no encontrado.
        </div>
    }
</div>
