@model Biblioteca.Plato
<div class="container mt-3">
    @if (Model != null)
    {
        <div class="card">
            <div class="card-header">
                <h2>Información del Plato</h2>
            </div>
            <div class="card-body">
                <!-- Mostrar imagen del plato -->
                @if (!string.IsNullOrEmpty(Model.imagen))
                {
                    <div class="text-center mb-3">
                        <img src="@Model.imagen" alt="Imagen del plato" class="img-fluid rounded" style="max-height: 300px; object-fit: cover;">
                    </div>
                }
                else
                {
                    <div class="alert alert-warning text-center">
                        Imagen no disponible.
                    </div>
                }
                <h5>Nombre del plato:</h5>
                <p>@Model.plato</p>

                <h5>Descripción:</h5>
                <p>@Model.descripcion</p>

                <h5>Disponible:</h5>
                @if (Model.disponible)
                {
                    <p>Sí</p>
                }
                else
                {
                    <p>No</p>
                }
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-header">
                <h2>Los creadores de esta exquisitez son</h2>
            </div>
            <div class="card-body">
                <h5>
                    <a class="dropdown-item" asp-controller="Restaurante" asp-action="ObtenerDetalleResto" asp-route-idRestaurant="@Model.idRestaurant">
                        <i class="bi bi-list-nested"></i> Nombre del Restaurante: @Model.Restaurant.restaurante
                    </a>
                </h5>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger" role="alert">
            Plato no encontrado.
        </div>
    }
</div>
